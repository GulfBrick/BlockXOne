FROM node:22.23.1-alpine AS builder

WORKDIR /build

COPY apps/web/package.json apps/web/package-lock.json ./
COPY apps/web/third_party/brace-expansion-compat ./third_party/brace-expansion-compat
RUN npm ci

COPY apps/web ./
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_REQUEST_ENABLED
ARG NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT
ARG NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL
ARG SERVER_ACTION_ALLOWED_ORIGINS
ARG BLOCKXONE_RELEASE_MODE
ARG NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE
ARG BLOCKXONE_WEB_SURFACE
ARG NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE
ARG NEXT_PUBLIC_BLOCKXONE_RUNTIME_SCOPE
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_DEMO_REQUEST_ENABLED=${NEXT_PUBLIC_DEMO_REQUEST_ENABLED}
ENV NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=${NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT}
ENV NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL=${NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL}
ENV SERVER_ACTION_ALLOWED_ORIGINS=${SERVER_ACTION_ALLOWED_ORIGINS}
ENV BLOCKXONE_RELEASE_MODE=${BLOCKXONE_RELEASE_MODE}
ENV NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE=${NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE}
ENV BLOCKXONE_WEB_SURFACE=${BLOCKXONE_WEB_SURFACE}
ENV NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE=${NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE}
ENV NEXT_PUBLIC_BLOCKXONE_RUNTIME_SCOPE=${NEXT_PUBLIC_BLOCKXONE_RUNTIME_SCOPE}
RUN npm run build

FROM builder AS test

RUN npm test

FROM node:22.23.1-alpine AS runtime

RUN apk add --no-cache dumb-init

WORKDIR /home/node

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_REQUEST_ENABLED
ARG NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT
ARG NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL
ARG SERVER_ACTION_ALLOWED_ORIGINS
ARG BLOCKXONE_RELEASE_MODE
ARG NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE
ARG BLOCKXONE_WEB_SURFACE
ARG NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE
ARG NEXT_PUBLIC_BLOCKXONE_RUNTIME_SCOPE
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_DEMO_REQUEST_ENABLED=${NEXT_PUBLIC_DEMO_REQUEST_ENABLED}
ENV NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=${NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT}
ENV NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL=${NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL}
ENV SERVER_ACTION_ALLOWED_ORIGINS=${SERVER_ACTION_ALLOWED_ORIGINS}
ENV BLOCKXONE_RELEASE_MODE=${BLOCKXONE_RELEASE_MODE}
ENV NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE=${NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE}
ENV BLOCKXONE_WEB_SURFACE=${BLOCKXONE_WEB_SURFACE}
ENV NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE=${NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE}
ENV NEXT_PUBLIC_BLOCKXONE_RUNTIME_SCOPE=${NEXT_PUBLIC_BLOCKXONE_RUNTIME_SCOPE}

COPY --from=builder --chown=node:node /build/.next/standalone ./
COPY --from=builder --chown=node:node /build/.next/static ./.next/static
COPY --from=builder --chown=node:node /build/public ./public

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "const r=require('http').get('http://127.0.0.1:3000/',x=>{x.resume();x.on('end',()=>process.exit(x.statusCode===200?0:1))});r.setTimeout(4000,()=>{r.destroy();process.exit(1)});r.on('error',()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
