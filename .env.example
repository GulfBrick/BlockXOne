# BlockXOne env (local dev)

APP_ENV=dev
HTTP_ADDR=:8080

# Auth
AUTH_MODE=dev  # local dev only; non-dev deployments should use jwt
DEV_ALLOW_ROLE_OVERRIDE=true  # local dev only
JWT_SECRET=replace-with-local-dev-secret

# Database
DATABASE_URL=postgres://blockxone:blockxone@localhost:5432/blockxone?sslmode=disable

# NATS
NATS_URL=nats://localhost:4222

# Redis (optional for rate limiting / locks)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_API=1000
RATE_LIMIT_AUTH=100

# Web/API contract
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Object storage (MinIO dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=blockxone-kyc
S3_REGION=us-east-1
S3_USE_SSL=false

# Chain adapter
CHAIN_MODE=mock   # mock|evm
CHAIN_ID=137
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
TOKEN_FACTORY_ADDRESS=

# Feature flags
ENABLE_MARKETPLACE=true
