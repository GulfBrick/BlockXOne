# BlockXOne env (local dev)

APP_ENV=dev
HTTP_ADDR=:8080

# Auth
AUTH_MODE=dev  # dev|oidc
DEV_ALLOW_ROLE_OVERRIDE=true

# Database
DATABASE_URL=postgres://blockxone:blockxone@localhost:5432/blockxone?sslmode=disable

# NATS
NATS_URL=nats://localhost:4222

# Redis (optional for rate limiting / locks)
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=blockxone-kyc
S3_REGION=us-east-1
S3_USE_SSL=false

# Chain adapter
CHAIN_MODE=mock   # mock|evm
CHAIN_ID=137

# Feature flags
ENABLE_MARKETPLACE=true
