# Opaque archives do not belong in source history. Recovery archives are held
# outside the repository under the controlled artifact policy.
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz
*.bz2
*.xz

# Local agent, connector and machine-specific state
.agents/
