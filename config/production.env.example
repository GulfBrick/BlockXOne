# Non-secret values solely for `docker compose config` validation.
# This .example domain configuration is intentionally non-deployable.
IMAGE_TAG=phase0-validation-only
JWT_SECRET=example-validation-value-with-more-than-thirty-two-characters
DATABASE_URL=postgres://validation-user:validation-password@db.internal.example:5432/blockxone?sslmode=verify-full
NATS_URL=tls://nats.internal.example:4222
REDIS_URL=rediss://redis.internal.example:6379/0
S3_ENDPOINT=https://documents.internal.example
S3_ACCESS_KEY=example-secret-manager-reference
S3_SECRET_KEY=example-secret-manager-reference
S3_BUCKET=regulated-documents
S3_REGION=af-south-1
CHAIN_ID=137
APPROVED_CHAIN_ID=137
CHAIN_RPC_URL=https://rpc.internal.example
KMS_KEY_ARN=kms://example-managed-key-reference
TOKEN_FACTORY_ADDRESS=0x1111111111111111111111111111111111111111
SUMSUB_APP_TOKEN=example-secret-manager-reference
SUMSUB_SECRET_KEY=example-secret-manager-reference
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_WEBHOOK_SECRET=example-secret-manager-reference
FIREBLOCKS_API_KEY=example-secret-manager-reference
FIREBLOCKS_SECRET_KEY_PATH=/run/secrets/fireblocks-private-key
FIREBLOCKS_BASE_URL=https://api.fireblocks.io
STRIPE_SECRET_KEY=example-secret-manager-reference
STRIPE_WEBHOOK_SECRET=example-secret-manager-reference
CORS_ALLOWED_ORIGINS=https://app.blockxone.example
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
NEXT_PUBLIC_API_URL=https://api.blockxone.example
SERVER_ACTION_ALLOWED_ORIGINS=app.blockxone.example
WEB_PORT=3000
