# Build stage
FROM golang:1.26.5-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

WORKDIR /build

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd/worker ./cmd/worker
COPY internal ./internal

# Build the binary with CGO disabled
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /worker \
    ./cmd/worker

# Runtime stage
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /home/appuser

# Copy binary from builder
COPY --from=builder --chown=appuser:appuser /worker /home/appuser/worker

# Switch to non-root user
USER appuser

# No port exposure for worker (background process)

# Health check (worker should be responsive to SIGTERM)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD kill -0 1 || exit 1

ENTRYPOINT ["/home/appuser/worker"]
