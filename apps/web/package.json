    "test:dependency-compat": "node --test scripts/dependency-compat.node-test.mjs",
    "test:config": "node --test scripts/production-url-policy.node-test.mjs scripts/production-runtime-contract.node-test.mjs",
    "predev": "node scripts/preflight.mjs && node scripts/check-copy-policy.mjs",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "node scripts/preflight.mjs && node scripts/check-copy-policy.mjs",
    "build": "next build",
    "prestart": "node scripts/preflight.mjs && node scripts/check-copy-policy.mjs",
    "start": "next start -p 3000 -H 0.0.0.0",
    "prelint": "node scripts/preflight.mjs && node scripts/check-copy-policy.mjs",
    "lint": "next lint",
    "pretest": "node scripts/preflight.mjs && node scripts/check-copy-policy.mjs",
    "test": "node scripts/run-hermetic-tests.mjs",
    "test:runner": "node --test scripts/run-hermetic-tests.node-test.mjs",
    "test:identity-sql": "node scripts/test-supabase-identity.mjs",
