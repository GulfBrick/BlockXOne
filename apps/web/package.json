    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "brace-expansion": "file:./third_party/brace-expansion-compat",
    "brace-expansion-upstream": "npm:brace-expansion@5.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
