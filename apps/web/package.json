    "pg": "^8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "server-only": "0.0.1",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.3",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
