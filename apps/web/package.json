{
  "name": "@blockxone/web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs && node scripts/check-copy-policy.mjs",
