# Public-only website build. Copy these names into the hosting provider's
# environment settings; do not commit real values or create a local .env file
# containing production secrets.
BLOCKXONE_WEB_SURFACE=public
NEXT_PUBLIC_BLOCKXONE_WEB_SURFACE=public
BLOCKXONE_RELEASE_MODE=production
NEXT_PUBLIC_BLOCKXONE_RELEASE_MODE=production

# Exact public host, without scheme, used by Next.js origin validation.
SERVER_ACTION_ALLOWED_ORIGINS=www.blockxone.example

# Public Supabase Edge Function URL. It contains no credential; the function
# performs its own validation, abuse controls, and server-side secret access.
# Intake is disabled until the endpoint and an approved notice are verified.
NEXT_PUBLIC_DEMO_REQUEST_ENABLED=false
NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=https://oqkevkjbkpugjotihtda.supabase.co/functions/v1/demo-request

# Counsel-reviewed, versioned notice naming the real data controller and
# privacy contact. Enabled intake builds fail closed if this is missing.
NEXT_PUBLIC_DEMO_PRIVACY_NOTICE_URL=

# Deliberately empty on the public-only surface. Authenticated platform routes
# remain fail-closed and there is no API rewrite.
NEXT_PUBLIC_API_URL=

# Optional real Auth/read-only workspace increment. Enable BOTH mode names
# together. Keep them blank to retain the public-only release. None of these
# server settings are NEXT_PUBLIC, and no service-role or secret key is allowed.
BLOCKXONE_AUTH_MODE=
NEXT_PUBLIC_BLOCKXONE_AUTH_MODE=
SUPABASE_URL=https://oqkevkjbkpugjotihtda.supabase.co
SUPABASE_PUBLISHABLE_KEY=
BLOCKXONE_APP_ORIGIN=https://bx1.co.za
