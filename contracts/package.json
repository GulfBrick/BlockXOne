{
  "name": "@blockxone/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "test:preflight": "node --test scripts/preflight.test.mjs",
    "typecheck": "npm run preflight -- --require-hardhat && tsc --noEmit",
    "compile": "npm run preflight -- --require-hardhat && hardhat build",
    "test": "npm run preflight -- --require-hardhat && hardhat test",
    "deploy:sepolia": "npm run preflight -- --require-hardhat --require-network sepolia && hardhat run scripts/deploy.ts --network sepolia",
    "deploy:goerli": "npm run preflight -- --require-hardhat --require-network goerli && hardhat run scripts/deploy.ts --network goerli"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.0.21",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@openzeppelin/contracts": "5.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.1",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.10.0",
    "mocha": "11.7.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "diff": "8.0.3",
    "serialize-javascript": "7.0.7"
  }
}
